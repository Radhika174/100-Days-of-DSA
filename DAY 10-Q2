#include <stdio.h>
int main() 
{
    int nums1[] = {1, 2, 2, 1};
    int nums2[] = {2, 2};
    int n1 = sizeof(nums1) / sizeof(nums1[0]);
    int n2 = sizeof(nums2) / sizeof(nums2[0]);
    int result[1000];
    int k = 0;
    for (int i = 0; i < n1; i++)
    {
        for (int j = 0; j < n2; j++)
        {
            if (nums1[i] == nums2[j]) 
            {
                result[k++] = nums1[i];
                nums2[j] = -1;
                break;
            }
        }
    }

    for (int i = 0; i < k; i++)
    {
        printf("%d ", result[i]);
    }

    return 0;
}
