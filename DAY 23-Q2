#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

struct Node {
    int data;
    struct Node* next;
};


bool hasCycle(struct Node *head) {
    if (head == NULL)
        return false;

    struct Node *slow = head;
    struct Node *fast = head;

    while (fast != NULL && fast->next != NULL) {
        slow = slow->next;
        fast = fast->next->next;   

        if (slow == fast)
            return true;
    }

    return false;   
}


struct Node* createNode(int value) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = value;
    newNode->next = NULL;
    return newNode;
}

int main() {

    struct Node *head = createNode(3);
    struct Node *second = createNode(2);
    struct Node *third = createNode(0);
    struct Node *fourth = createNode(-4);

   
    head->next = second;
    second->next = third;
    third->next = fourth;

   
    fourth->next = second;

    if (hasCycle(head))
        printf("true\n");
    else
        printf("false\n");

    return 0;
}
